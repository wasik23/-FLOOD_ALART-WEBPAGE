# Server
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# --- MySQL (Sequelize) ---------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reliefops
DB_USER=root
DB_PASSWORD=
# 'safe' (default, sync only missing tables), 'alter', 'force', or 'off'.
DB_SYNC=safe
# If true, the process exits when the DB is unavailable. Otherwise it warns.
DB_REQUIRED=false
DB_LOGGING=false

# --- JWT ------------------------------------------------------------------
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Seed (used by `npm run db:seed`) ------------------------------------
SEED_ADMIN_EMAIL=admin@reliefops.local
SEED_ADMIN_PASSWORD=ChangeMe!2026

# Which SMS provider to use: "ssl" (SSL Wireless BD) or "twilio".
# When unset or empty, the gateway falls back to dry-run mode (logs the SMS).
SMS_PROVIDER=ssl

# Sender ID shown on outbound alerts.
SMS_BRAND=ReliefOps

# --- SSL Wireless BD (sms.sslwireless.com) -------------------------------
# Sign up: https://www.sslwireless.com/sms
SSL_SMS_API_TOKEN=
SSL_SMS_SID=
SSL_SMS_API_URL=https://smsplus.sslwireless.com/api/v3/send-sms

# --- Twilio fallback -----------------------------------------------------
# Used automatically if the SSL Wireless call fails (or when
# SMS_PROVIDER=twilio is set explicitly).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
